# Plantilla de configuración de Intersoft.
# Copia este archivo como .env, en esta misma carpeta, y llena tus valores.
# Las variables del sistema tienen prioridad sobre las de .env.
# Nunca subas .env a git ni compartas sus valores.

# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
# Clave secreta, larga y aleatoria (50 caracteres o más). Obligatoria. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# True solo en tu computador: muestra errores detallados y sirve las fotos.
# En producción déjalo en False, que es el valor por defecto si falta.
DEBUG=False

# Dominios que atiende el sitio, separados por coma. Ejemplo: tienda.intersoft.co,www.tienda.intersoft.co
# Con DEBUG=True y vacío, se aceptan localhost y 127.0.0.1.
ALLOWED_HOSTS=

# Orígenes completos (con https://) desde los que se envían formularios, separados por coma.
# Ejemplo: https://tienda.intersoft.co
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------
# HTTPS: solo se aplican con DEBUG=False
# ---------------------------------------------------------------
# Redirige http:// a https://.
SECURE_SSL_REDIRECT=True
# Segundos que el navegador recordará usar solo HTTPS (HSTS). 31536000 = un año.
SECURE_HSTS_SECONDS=31536000
# Aplica HSTS a todos los subdominios. Actívalo solo si TODOS tus subdominios usan HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Permite pedir que el dominio entre en la lista de precarga de los navegadores. Es difícil de revertir.
SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------
# Registros, avisos y correo (SMTP opcional)
# ---------------------------------------------------------------
# Correos que reciben los avisos críticos de pagos (reembolsos, cobros duplicados), separados por coma.
# Si EMAIL_HOST está vacío, los correos se muestran por consola (respaldo de desarrollo).
ADMINS=
# Carpeta del archivo de registros (intersoft.log, con rotación). Por defecto: logs/ junto a manage.py.
LOG_DIR=

# Configuración SMTP para producción (si EMAIL_HOST se deja vacío, se usa console.EmailBackend):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-responder@intersoft.local
SERVER_EMAIL=no-responder@intersoft.local

# Monitoreo externo de errores opcional (Sentry). Si SENTRY_DSN está vacío, queda desactivado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Caché compartida opcional (Redis). Si está vacío usa memoria local (solo desarrollo/pruebas).
# En producción con compose.prod.yml se configura automáticamente como redis://redis:6379/1.
REDIS_URL=

# ---------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------
DB_NAME=intersoft
DB_USER=postgres
# Obligatoria.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------
# Wompi de Intersoft: reservado al futuro cobro de membresías.
# Las llaves para ventas se configuran por negocio en Panel → Negocio → Pagos.
# Al migrar, estas llaves se conservan cifradas en los intentos históricos existentes.
# En desarrollo usa SOLO llaves de Sandbox (pub_test_, test_integrity_, test_events_, prv_test_).
# ---------------------------------------------------------------
# Llave pública: identifica al comercio en el checkout.
WOMPI_PUBLIC_KEY=
# Secreto de integridad: firma el monto y la referencia de cada cobro.
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos: verifica la firma de los webhooks.
WOMPI_EVENTS_SECRET=
# Llave privada: consulta transacciones desde el servidor.
WOMPI_PRIVATE_KEY=
# Solo para desarrollo, y además exige DEBUG=True: cobra con un simulador en vez de Wompi.
PASARELA_SIMULADA=False

# ---------------------------------------------------------------
# Cobro de planes (cuenta de Wompi de INTERSOFT, no de los negocios)
# ---------------------------------------------------------------
# Sin la llave pública los planes pagos no se pueden contratar. Pruebas: pub_test_ / test_integrity_ ...
# En Wompi configura la URL de eventos: https://<tu-dominio>/webhooks/wompi/suscripciones/
SUSCRIPCIONES_WOMPI_PUBLIC_KEY=
SUSCRIPCIONES_WOMPI_INTEGRITY_SECRET=
SUSCRIPCIONES_WOMPI_EVENTS_SECRET=
# Recomendada: permite confirmar el pago al volver de Wompi y conciliar los pendientes.
SUSCRIPCIONES_WOMPI_PRIVATE_KEY=

# ---------------------------------------------------------------
# Pedidos del marketplace (opcionales: estos son los valores por defecto)
# ---------------------------------------------------------------
# Minutos que se reserva el stock de un pedido sin pagar.
PEDIDO_MINUTOS_RESERVA=30
# Si a la reserva le quedan menos minutos que estos, se pide renovarla antes de abrir Wompi.
PEDIDO_MINUTOS_MINIMOS_PAGO=5
# Cuántas veces se puede renovar la reserva de un pedido.
PEDIDO_MAX_RENOVACIONES=2
# Minutos extra, desde el vencimiento, que se espera una transacción que Wompi tiene en proceso.
PEDIDO_MAX_ESPERA_PENDIENTE_MINUTOS=120

# ---------------------------------------------------------------
# Valores antiguos (compatibilidad). Las tarifas y su traslado se guardan por negocio.
# ---------------------------------------------------------------
WOMPI_COBRAR_TARIFA_AL_COMPRADOR=True
WOMPI_TARIFA_PORCENTAJE=2.65
WOMPI_TARIFA_FIJA=700
WOMPI_TARIFA_IVA=19

# ---------------------------------------------------------------
# WhatsApp Cloud API: aviso al negocio cuando entra un pedido pagado (opcional)
# Plantilla aprobada por Meta en español con 3 variables: {{1}} pedido, {{2}} total, {{3}} cliente.
# ---------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=
WHATSAPP_PLANTILLA_PEDIDO=

# --- Pasarela propia de cada negocio ---
# Clave Fernet que cifra las llaves de Wompi de cada negocio en la base de datos.
# Genera una: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Para rotar: pon la nueva primero, separada por coma de la anterior, y ejecuta
#   python manage.py rotar_secretos_pago
PAGOS_CLAVES_CIFRADO=

# ---------------------------------------------------------------
# Límite de peticiones
# ---------------------------------------------------------------
# Proxies de confianza delante de Django: 0 en local (sin proxy), 1 detrás de nginx (compose.prod.yml).
RATELIMIT_PROXIES_DE_CONFIANZA=0

# --- Protección de datos personales (Ley 1581 de 2012) ---
# Datos del responsable del tratamiento que aparecen en la política de /privacidad/.
# Son obligatorios antes de salir a producción (Decreto 1377 art. 13).
DATOS_RESPONSABLE_RAZON_SOCIAL=
DATOS_RESPONSABLE_NIT=
DATOS_RESPONSABLE_DIRECCION=
DATOS_RESPONSABLE_CORREO=
DATOS_RESPONSABLE_TELEFONO=
# True: quien inicia sesión sin haber aceptado la política vigente debe aceptarla primero.
PROTECCION_DATOS_EXIGIR_AUTORIZACION=True
