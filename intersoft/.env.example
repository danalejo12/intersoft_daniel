# Plantilla de configuración de Intersoft.
# Copia este archivo como .env, en esta misma carpeta, y llena tus valores.
# Las variables del sistema tienen prioridad sobre las de .env.
# Nunca subas .env a git ni compartas sus valores.

# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
# Clave secreta, larga y aleatoria (50 caracteres o más). Obligatoria. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# True solo en tu computador: muestra errores detallados y sirve las fotos.
# En producción déjalo en False, que es el valor por defecto si falta.
DEBUG=False

# Dominios que atiende el sitio, separados por coma. Ejemplo: tienda.intersoft.co,www.tienda.intersoft.co
# Con DEBUG=True y vacío, se aceptan localhost y 127.0.0.1.
ALLOWED_HOSTS=

# Orígenes completos (con https://) desde los que se envían formularios, separados por coma.
# Ejemplo: https://tienda.intersoft.co
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------
# HTTPS: solo se aplican con DEBUG=False
# ---------------------------------------------------------------
# Redirige http:// a https://.
SECURE_SSL_REDIRECT=True
# Segundos que el navegador recordará usar solo HTTPS (HSTS). 31536000 = un año.
SECURE_HSTS_SECONDS=31536000
# Aplica HSTS a todos los subdominios. Actívalo solo si TODOS tus subdominios usan HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Permite pedir que el dominio entre en la lista de precarga de los navegadores. Es difícil de revertir.
SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------
DB_NAME=intersoft
DB_USER=postgres
# Obligatoria.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------
# Wompi
# En desarrollo usa SOLO llaves de Sandbox (pub_test_, test_integrity_, test_events_, prv_test_).
# ---------------------------------------------------------------
# Llave pública: identifica al comercio en el checkout.
WOMPI_PUBLIC_KEY=
# Secreto de integridad: firma el monto y la referencia de cada cobro.
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos: verifica la firma de los webhooks.
WOMPI_EVENTS_SECRET=
# Llave privada: consulta transacciones desde el servidor.
WOMPI_PRIVATE_KEY=
# Solo para desarrollo, y además exige DEBUG=True: cobra con un simulador en vez de Wompi.
PASARELA_SIMULADA=False

# ---------------------------------------------------------------
# Pedidos del marketplace (opcionales: estos son los valores por defecto)
# ---------------------------------------------------------------
# Minutos que se reserva el stock de un pedido sin pagar.
PEDIDO_MINUTOS_RESERVA=30
# Si a la reserva le quedan menos minutos que estos, se pide renovarla antes de abrir Wompi.
PEDIDO_MINUTOS_MINIMOS_PAGO=5
# Cuántas veces se puede renovar la reserva de un pedido.
PEDIDO_MAX_RENOVACIONES=2
# Minutos extra, desde el vencimiento, que se espera una transacción que Wompi tiene en proceso.
PEDIDO_MAX_ESPERA_PENDIENTE_MINUTOS=120
